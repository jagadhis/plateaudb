{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "plateaudb": ["../plateau/src/index.ts"],
      "plateau-engine": ["../../crates/engine/pkg/plateau_engine.d.ts"]
    }
  },
  "include": ["src", "runner", "vite.config.ts"]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "plateaudb": ["./src/index.ts"],
      "plateau-engine": ["../../crates/engine/pkg/plateau_engine.d.ts"]
    }
  },
  "include": ["src", "test", "conformance", "build.ts"]
}
